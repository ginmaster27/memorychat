  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@types/react-dom": "^18.2.18",
    "@types/react": "^18.2.37",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
